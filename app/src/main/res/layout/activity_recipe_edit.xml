<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Template name + edit/delete icons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/recipeNameEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="textCapSentences"
            android:hint="@string/carblookup_recipe_name_hint"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/editTitleButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/carblookup_context_edit"
            android:src="@android:drawable/ic_menu_edit"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/deleteTemplateButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/carblookup_context_delete"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Carbs summary row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/totalCarbsTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/carblookup_total_per_portion_default"
            android:textSize="15sp"
            android:textColor="@color/carbsHighlight"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Portions + Meal time row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/portionCountEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="numberDecimal"
            android:hint="@string/carblookup_portions_label"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carblookup_meal_time_label"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/mealTimeSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Notes -->
    <EditText
        android:id="@+id/recipeNotesEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="3"
        android:hint="@string/carblookup_notes_hint"
        android:layout_marginBottom="8dp" />

    <!-- Item list -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <ListView
            android:id="@+id/recipeItemsListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp" />

        <TextView
            android:id="@+id/emptyItemsTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/carblookup_empty_current_meal"
            android:textColor="@android:color/darker_gray" />

    </FrameLayout>

    <!-- Save button pinned above ingredient actions -->
    <com.eveningoutpost.dexdrip.carblookup.CenteredIconButton
        android:id="@+id/saveRecipeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/colorPrimary"
        android:drawableStart="@drawable/ic_save_white_24dp"
        android:drawablePadding="8dp"
        android:gravity="start|center_vertical"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minHeight="48dp"
        android:text="@string/carblookup_save_recipe"
        android:textStyle="bold" />

    <!-- Add ingredient buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addItemButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_barcode"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_scan_barcode"
            android:textSize="12sp" />

        <Button
            android:id="@+id/addManualItemButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_manual_entry"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/itemSearchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_item_search"
            android:textSize="12sp" />

        <Button
            android:id="@+id/commonFoodsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_common_foods"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
