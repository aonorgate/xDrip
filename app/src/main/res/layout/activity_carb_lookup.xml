<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addTemplateButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_add_template"
            android:textSize="12sp" />

        <Button
            android:id="@+id/myRecipesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_my_recipes"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/favoritesButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_favorites"
            android:textSize="12sp" />

        <Button
            android:id="@+id/viewHistoryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_view_saved_meals"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="0dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carblookup_current_meal"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/carbsResultTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/carblookup_carbs_zero"
            android:textColor="@color/carbsHighlight"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/clearMealButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/colorPrimary"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="40dp"
            android:text="@string/carblookup_clear"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/carblookup_meal_time_label"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/currentMealTimeSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <EditText
            android:id="@+id/currentMealClockTimeEditText"
            android:layout_width="76dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:hint="@string/carblookup_meal_clock_time_hint"
            android:imeOptions="actionDone"
            android:inputType="time"
            android:maxLength="5"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textAlignment="center"
            android:textSize="14sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/mealNotesEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/carblookup_meal_notes_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="3"
        android:layout_marginTop="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <ListView
            android:id="@+id/currentMealListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp" />

        <TextView
            android:id="@+id/emptyCurrentMealTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/carblookup_empty_current_meal"
            android:textColor="@android:color/darker_gray" />

    </FrameLayout>

    <com.eveningoutpost.dexdrip.carblookup.CenteredIconButton
        android:id="@+id/logMealButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/colorPrimary"
        android:drawableStart="@drawable/ic_save_white_24dp"
        android:drawablePadding="8dp"
        android:gravity="start|center_vertical"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:minHeight="48dp"
        android:text="@string/carblookup_log_meal"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/scanButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_barcode"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_scan_barcode"
            android:textSize="12sp" />

        <Button
            android:id="@+id/manualEntryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_manual_entry"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/itemSearchButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_item_search"
            android:textSize="12sp" />

        <Button
            android:id="@+id/commonFoodsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="4dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minHeight="44dp"
            android:text="@string/carblookup_common_foods"
            android:textSize="12sp" />

    </LinearLayout>
</LinearLayout>
